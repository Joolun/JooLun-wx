.page{min-height:100vh;padding:28rpx;background:#f5f7fa}.card{padding:38rpx;border-radius:28rpx;background:linear-gradient(135deg,#232c44,#3e527d);color:#fff}.level{font-size:36rpx;font-weight:700}.summary{display:flex;justify-content:space-between;margin-top:38rpx}.summary>view{text-align:center}.value,.label{display:block}.value{font-size:36rpx;font-weight:700}.label{margin-top:8rpx;font-size:22rpx;opacity:.75}.progress{height:12rpx;margin-top:34rpx;border-radius:8rpx;background:rgba(255,255,255,.18);overflow:hidden}.bar{height:100%;background:#f4ca73}.next{margin-top:14rpx;font-size:22rpx;opacity:.8}.rule{margin-top:22rpx;padding:24rpx;border-radius:18rpx;background:#fff;color:#777;font-size:24rpx;line-height:1.7}.title{margin:34rpx 0 18rpx;font-size:30rpx;font-weight:700}.log{display:flex;justify-content:space-between;align-items:center;padding:26rpx;margin-bottom:2rpx;background:#fff}.remark{font-size:27rpx}.time{margin-top:8rpx;color:#aaa;font-size:21rpx}.change{color:#555;font-size:30rpx;font-weight:700}.change.plus{color:#e29a28}.empty{padding:80rpx;text-align:center;color:#999}
