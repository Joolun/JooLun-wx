.page{min-height:100vh;padding:24rpx;background:#f5f7fa}.tabs{display:flex;margin-bottom:24rpx;background:#fff;border-radius:18rpx}.tab{flex:1;padding:24rpx;text-align:center;color:#777}.tab.active{color:#2967ff;font-weight:700;border-bottom:4rpx solid #2967ff}.coupon{display:flex;align-items:center;margin-bottom:20rpx;padding:28rpx 22rpx;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 26rpx rgba(0,0,0,.05)}.amount{width:150rpx;color:#ef4f4f;font-size:54rpx;font-weight:700}.currency{font-size:26rpx}.info{flex:1;min-width:0}.name{font-size:30rpx;font-weight:700}.desc,.time{margin-top:10rpx;color:#8a8f99;font-size:22rpx}.action{width:120rpx;padding:0;border-radius:40rpx;background:#2967ff;color:#fff;font-size:24rpx;line-height:64rpx}.action[disabled]{background:#d8dbe2;color:#fff}.state{color:#8a8f99;font-size:24rpx}.empty{padding:120rpx 0;text-align:center;color:#999}
