<view class="page"><view class="goods"><view class="name">{{spuName}}</view><view class="spec">{{specInfo || '默认规格'}}</view></view><view class="panel"><view class="label">商品评分</view><view class="stars"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{item <= rating ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseRating">★</text></view><textarea class="textarea" maxlength="500" placeholder="分享你的真实使用体验（选填）" bindinput="inputContent"></textarea><view class="anonymous"><text>匿名评价</text><switch color="#2967ff" bindchange="changeAnonymous" /></view></view><button class="submit" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交评价</button></view>
